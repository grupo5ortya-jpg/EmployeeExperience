
#Constantes de configuracion
PROJECT_NAME="Employee Experience"
ALLOWED_DOMAINS="*"
ALLOWED_METHODS="GET, POST, PATCH, DELETE"

# ¡CUIDADO! {"force":true} BORRA Y RECREA TODA LA BASE en cada arranque del server.
# Usar {"force":false} salvo que sepas exactamente lo que estás haciendo (ej. reset local).
SYNC_PARAMS={"force":false}

# Sembrar datos de ejemplo (empleados/usuarios/contraseñas falsas tipo pass1, pass2...) al
# arrancar. Poner en "false" para una base real de cliente/producción.
RUN_SEEDS=true

#Puerto de la aplicacion
PORT=3002

#Postgres
DB_HOST=localhost
DB_NAME=employee_experience
DB_SCHEMA=main
DB_USER=postgres
DB_PASSWORD=
DB_DIALECT=postgres
DB_PORT=5432

#Auth — JWT propio (no se usa Auth0, a pesar de variables que pudieran haber existido antes)
JWT_SECRET=cambiar_por_un_string_largo_y_secreto
FRONTEND_URL=http://localhost:5173

#Gemini (opcional — sin esta key, las features de IA quedan deshabilitadas sin romper el resto)
GEMINI_API_KEY=

# Envío de emails reales ligado a las Alertas (ver utils/mailer.js + utils/alertMailer.js).
# En "false" (default) el sistema sigue funcionando 100% in-app, sin mandar ningún mail —
# útil en desarrollo local sin SMTP configurado.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
