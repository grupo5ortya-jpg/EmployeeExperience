# Copiar a ".env" en la raíz del repo (docker-compose lo lee automáticamente) y completar
# antes de levantar con: docker compose up --build

# Postgres
DB_NAME=employee_experience
DB_USER=postgres
DB_PASSWORD=cambiar_esta_password
DB_PORT=5432

# Backend
# false para una base de cliente/producción real (sin empleados/usuarios falsos) — ver
# docs/jira-documentation.md y CLAUDE.md para el detalle de por qué existe esta variable.
RUN_SEEDS=true
JWT_SECRET=cambiar_por_un_string_largo_y_secreto
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=

# Frontend (se "bakea" en el build, no es una env var de runtime — ver server/frontend/Dockerfile)
VITE_API_URL=http://localhost:3002
